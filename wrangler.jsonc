{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novaproxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "73f2291c-c101-409b-b0fa-480c9c5fcdf8","database_name": "nova_db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1e750fce2ba741338e8c8fc6b2413368" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
